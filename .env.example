# Use este arquivo como referência e defina as variáveis no ambiente do processo.
# O projeto NÃO carrega .env automaticamente; use export/Set-Item ou o gerenciador
# de processos do servidor.

# Desenvolvimento local (padrão quando a variável não é definida)
DJANGO_DEBUG=True

# Produção: obrigatório, gere com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Produção: lista separada por vírgulas, sem esquema (ex.: cantina.exemplo.com,www.cantina.exemplo.com)
DJANGO_ALLOWED_HOSTS=

# Produção: origens confiáveis para CSRF, com esquema (ex.: https://cantina.exemplo.com)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Deixe False quando o TLS termina no próprio Django; True quando há proxy reverso confiável.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_BEHIND_PROXY=False

# Login local de desenvolvimento (usado por "python manage.py dev_login").
# Funciona somente com DJANGO_DEBUG=True; a rota responde 404 em produção.
DJANGO_DEV_LOGIN_BASE_URL=http://127.0.0.1:8000
DJANGO_DEV_LOGIN_MAX_AGE=3600
